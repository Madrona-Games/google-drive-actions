{
  "name": "google-drive-actions",
  "description": "Google Drive API actions",
  "version": "1.0.0",
  "author": "Madrona Games Inc",
  "homepage": "https://github.com/Madrona-Games/google-drive-actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Madrona-Games/google-drive-actions.git"
  },
  "bugs": {
    "url": "https://github.com/Madrona-Games/google-drive-actions/issues"
  },
  "keywords": [
    "actions",
    "google"
  ],
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build:debug": "npm install && tsc",
    "build": "npm install && tsc && node esbuild.config.mjs",
    "lint": "prettier --check \"src/**/*.{js,ts}\" && eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{js,ts}\""
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.6.1",
    "@actions/io": "^3.0.2",
    "@googleapis/drive": "^20.1.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.27.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.1",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^64.0.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0"
  },
  "volta": {
    "node": "24.14.0"
  }
}
