{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "sourceMap": true,
    "outDir": "./lib",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["./src/**/*"],
  "exclude": ["./dist", "./node_modules", "./__tests__", "./coverage"]
}
